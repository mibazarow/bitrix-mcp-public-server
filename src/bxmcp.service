[Unit]
Description=BxMCP Server - Bitrix MCP LiveAPI
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/bitrix-mcp
ExecStart=/usr/local/bin/bxmcp-node /opt/bitrix-mcp/dist/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=BITRIX_PATH=/home/bitrix/ext_www/camouf.ru/bitrix/modules
Environment=EMBEDDINGS_URL=http://127.0.0.1:8000
Environment=PORT=3100
Environment=EMBEDDING_DIM=256
Environment=EMBEDDING_MODEL=google/embeddinggemma-2

[Install]
WantedBy=multi-user.target
